# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# The service role key is SERVER ONLY. Never expose it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Payments
# PAYMENT_PROVIDER = stripe | mock   (mock is refused in production)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Transactional emails
# EMAIL_PROVIDER = resend | console   (console only logs, refused in production)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Atelier <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Shipping / labels
# SHIPPING_PROVIDER = mock | (future: boxtal, sendcloud, colissimo...)
# ---------------------------------------------------------------------------
SHIPPING_PROVIDER=mock
SHIPPING_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Analytics (optional). Internal analytics always works without these.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# ---------------------------------------------------------------------------
# Internal jobs (cron endpoints such as review requests, shipment tracking sync)
# ---------------------------------------------------------------------------
CRON_SECRET=
