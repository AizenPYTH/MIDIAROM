# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase (https://supabase.com/dashboard/project/_/settings/api)
# The service role key is SERVER ONLY. Never expose it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Payments
# PAYMENT_PROVIDER = stripe | mock   (mock is refused in production)
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# IGDB (fiches de jeux vidéo). Authentification par Twitch OAuth.
# https://dev.twitch.tv/console/apps -> Register Your Application
# Le secret ne doit JAMAIS être exposé : pas de variante NEXT_PUBLIC_*.
# Sans ces variables, le site fonctionne : les produits gardent leurs photos.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Transactional emails
# EMAIL_PROVIDER = resend | console   (console only logs, refused in production)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="Atelier <no-reply@example.com>"

# ---------------------------------------------------------------------------
# Shipping / labels
# SHIPPING_PROVIDER = mock | (future: boxtal, sendcloud, colissimo...)
# ---------------------------------------------------------------------------
SHIPPING_PROVIDER=mock
SHIPPING_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Analytics (optional). Internal analytics always works without these.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=

# ---------------------------------------------------------------------------
# Internal jobs (cron endpoints such as review requests, shipment tracking sync)
# ---------------------------------------------------------------------------
CRON_SECRET=

# ---------------------------------------------------------------------------
# Figurine catalog import (Admin > Catalogue > Importer une figurine)
# HLJ search results are browser-rendered and HLJ publishes no search API, so
# the search goes through a dedicated Apify actor. Only APIFY_TOKEN is needed.
# Optional overrides let you swap actor or endpoint without touching the code.
# ---------------------------------------------------------------------------
APIFY_TOKEN=
# HLJ_APIFY_ACTOR=lulzasaur/hlj-scraper
# HLJ_APIFY_INPUT={"searchQueries":["{q}"],"maxItems":{limit},"scrapeDetails":true}
# HLJ_SEARCH_API=
# HLJ_USER_AGENT=
# HLJ_ENRICH_DETAILS=
